# Stage 1 : Compilation autonome du backend Spring Boot (sans Java/Maven local)
FROM maven:3.9.9-eclipse-temurin-21 AS build

WORKDIR /build

# Mise en cache des dependances Maven
COPY pom.xml .
RUN mvn -B dependency:go-offline

# Compilation du JAR executable
COPY src ./src
RUN mvn -B package -DskipTests

# Stage 2 : Image legere d'execution
FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /build/target/*.jar royaume-back.jar

EXPOSE 8080

CMD ["java", "-jar", "royaume-back.jar"]
