# ===================================================================
# Configuration Multijoueur (BDD MySQL distante partagee)
#
# INSTRUCTIONS :
# 1. Copiez ce fichier en ".env.multi" a la racine du projet.
# 2. Renseignez REMOTE_DB_PASSWORD (le mot de passe du serveur MySQL).
# 3. ".env.multi" est ignore par Git : vos identifiants restent locaux.
# ===================================================================

# Serveur MySQL distant du groupe
REMOTE_DB_HOST=20.84.69.4
REMOTE_DB_PORT=3326
REMOTE_DB_NAME=royaume_multi
REMOTE_DB_USER=root
REMOTE_DB_PASSWORD=A_RENSEIGNER

# (Host uniquement) Strategie Hibernate :
# - update : recommande par defaut (preserve la partie si le Host redemarre)
# - create : uniquement pour repartir d'une base completement vierge
HOST_DDL_AUTO=update

# Ports exposes localement sur votre PC (distincts de Vierge :82 et Demo :83)
MULTI_FRONT_PORT=84
MULTI_BACK_PORT=8094
