# Stage 1 : Compilation autonome du frontend Angular (sans Node/npm local)
FROM node:lts-alpine AS build

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx ng build

# Stage 2 : Serveur Nginx avec proxy /api/ vers le conteneur java:8080
FROM nginx:alpine

WORKDIR /usr/share/nginx/html

RUN rm -rf /usr/share/nginx/html/*

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/royaume_front/browser/ .

EXPOSE 80
